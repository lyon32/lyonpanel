# LyonPanel — variables d'environnement (modèle, SANS valeurs réelles)
# Copier en .env.local et remplir. Ne jamais commiter .env.local.
# Détails : ENV_SETUP.md

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Référencement : le site reste en noindex (robots.txt « Disallow: / », sitemap vide) tant que cette valeur n'est pas exactement « true ».
# À passer à true uniquement à la mise en ligne sur lyonpanel.com (phase 16). Pages client et admin restent noindex dans tous les cas.
SITE_INDEXABLE=false
# Adresse de support affichée sur la page Contact (optionnelle : vide = non affichée).
NEXT_PUBLIC_SUPPORT_EMAIL=
# Adresse secrète de l'admin (serveur seulement, jamais NEXT_PUBLIC_) : 8 à 64 caractères, lettres/chiffres/-/_.
# Vide = admin fermé. Ne jamais l'écrire dans un journal ni un lien public.
ADMIN_PATH=
# Enrôlement des appareils admin : vide ou true = ouvert (moins de 2 appareils), false = fermé.
ADMIN_ENROLL_OPEN=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Fournisseur (API v2) ---
PROVIDER_API_URL=https://example.invalid/api/v2
PROVIDER_API_KEY=
PROVIDER_MODE=mock

# --- SasPay ---
SASPAY_API_URL=https://api.saspay.me/api/v1
SASPAY_API_KEY=
SASPAY_WEBHOOK_SECRET=
SASPAY_MODE=test

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Tâches planifiées ---
CRON_SECRET=

# --- Routes de test (faux fournisseur, jamais en production) ---
TEST_ROUTE_SECRET=

# --- Comptes : secret des hash anti-force-brute (openssl rand -hex 32) ---
AUTH_HASH_SECRET=
# Secret Turnstile lu par Supabase Auth (connexion, mot de passe oublié) ; vide en local sauf pour `supabase start`
SUPABASE_AUTH_CAPTCHA_SECRET=

# --- Sentry (suivi des erreurs) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Analytics ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
