# LyonPanel — variables d'environnement (modèle, SANS valeurs réelles)
# Copier en .env.local et remplir. Ne jamais commiter .env.local.
# Détails : ENV_SETUP.md

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_PATH=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- JustAnotherPanel ---
JAP_API_URL=https://justanotherpanel.com/api/v2
JAP_API_KEY=
JAP_MODE=mock

# --- SasPay ---
SASPAY_API_URL=https://api.saspay.me/api/v1
SASPAY_API_KEY=
SASPAY_WEBHOOK_SECRET=
SASPAY_MODE=test

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Tâches planifiées ---
CRON_SECRET=

# --- Comptes : secret des hash anti-force-brute (openssl rand -hex 32) ---
AUTH_HASH_SECRET=

# --- Sentry (suivi des erreurs) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Analytics ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
